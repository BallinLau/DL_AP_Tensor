#!/bin/bash
#SBATCH -J dl-scaled-value-pilot
#SBATCH -N 1
#SBATCH -p a01
#SBATCH -o /home/fit/zhuyingz/WORK/LiuHao/logs/dl_scaled_value_pilot_output.%j
#SBATCH -e /home/fit/zhuyingz/WORK/LiuHao/logs/dl_scaled_value_pilot_error.%j
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --time=1-00:00:00

set -euo pipefail

WORK_ROOT="${WORK_ROOT:-/home/fit/zhuyingz/WORK/LiuHao}"
REPO_DIR="${REPO_DIR:-$WORK_ROOT/DL_AP_Tensor}"
STAMP=$(date +%Y%m%d_%H%M%S)

# Keep the formal BP-logit/mixture training scale used in the previous run.
export RUN_ROOT="${RUN_ROOT:-$WORK_ROOT/cachedir/normalized_sdf_aio_bp_logit_scaled_value_${STAMP}}"
export SEED="${SEED:-12345}"
export N_EPISODES="${N_EPISODES:-10}"
export EPOCHS="${EPOCHS:-100}"
export N_PATHS="${N_PATHS:-400}"
export POST0_N_PATHS="${POST0_N_PATHS:-400}"
export BATCH_SIZE="${BATCH_SIZE:-4096}"
export PV_BATCH_SIZE="${PV_BATCH_SIZE:-20480}"
export SDF_FC1_BATCH_SIZE="${SDF_FC1_BATCH_SIZE:-4096}"
export SIMULATE_GROUP_SIZE="${SIMULATE_GROUP_SIZE:-200}"
export SIMULATE_HORIZON="${SIMULATE_HORIZON:-100}"
export POST0_MODE="${POST0_MODE:-modeb}"
export ALTERNATE_START="${ALTERNATE_START:-modea}"
export ENABLE_FC2="${ENABLE_FC2:-0}"
export QUICK_TEST="${QUICK_TEST:-0}"

export SDF_WEALTH_LOSS_MODE="${SDF_WEALTH_LOSS_MODE:-signed_aio}"
export SDF_FRESH_PAIR_ENABLED="${SDF_FRESH_PAIR_ENABLED:-1}"
export SDF_CHILD_BANK_SIZE="${SDF_CHILD_BANK_SIZE:-16}"
export SDF_CHILD_BANK_REFRESH_EPOCHS="${SDF_CHILD_BANK_REFRESH_EPOCHS:-1}"
export SDF_CHILD_BANK_SEED="${SDF_CHILD_BANK_SEED:-12345}"
export EPISODE0_SDF_EPOCHS_PER_ROUND="${EPISODE0_SDF_EPOCHS_PER_ROUND:-20}"
export EPISODE0_SDF_MAX_ROUNDS="${EPISODE0_SDF_MAX_ROUNDS:-20}"
export EPISODE0_SDF_LOG_MEAN_ERROR_MAX="${EPISODE0_SDF_LOG_MEAN_ERROR_MAX:-0.25}"
export EPISODE0_SDF_CLIP_LOW_RATIO_MAX="${EPISODE0_SDF_CLIP_LOW_RATIO_MAX:-0.20}"
export EPISODE0_SDF_FINITE_RATIO_MIN="${EPISODE0_SDF_FINITE_RATIO_MIN:-1.0}"
export SDF_TRUE_ONLY_EPOCHS="${SDF_TRUE_ONLY_EPOCHS:-100}"
export SDF_RECURSIVE_ONLY_EPOCHS="${SDF_RECURSIVE_ONLY_EPOCHS:-0}"
export SDF_STAGE2_LR="${SDF_STAGE2_LR:-2e-4}"
export SDF_TRUE_ONLY_LR="${SDF_TRUE_ONLY_LR:-4e-5}"
export SDF_TRUE_TARGET_BATCHES="${SDF_TRUE_TARGET_BATCHES:-20}"
export SDF_MIN_PARENT_GROUPS_PER_BATCH="${SDF_MIN_PARENT_GROUPS_PER_BATCH:-256}"
export SDF_TRUE_MOMENT_WEIGHT="${SDF_TRUE_MOMENT_WEIGHT:-5e-4}"
export SDF_TRUE_ANCHOR_WEIGHT="${SDF_TRUE_ANCHOR_WEIGHT:-0.05}"
export SDF_RESET_OPTIMIZER_ON_TRUE_START="${SDF_RESET_OPTIMIZER_ON_TRUE_START:-0}"
export SDF_RESTORE_BEST_CHECKPOINT="${SDF_RESTORE_BEST_CHECKPOINT:-1}"
export SDF_COLLAPSE_LOG_MEAN_ERROR="${SDF_COLLAPSE_LOG_MEAN_ERROR:-0.5}"
export SDF_COLLAPSE_MEAN_RATIO="${SDF_COLLAPSE_MEAN_RATIO:-0.10}"
export FC1_JACOBIAN_PENALTY_INTERVAL="${FC1_JACOBIAN_PENALTY_INTERVAL:-10}"

export BP_GRID_POLICY_LOSS_SPACE="${BP_GRID_POLICY_LOSS_SPACE:-logit}"
export BP_GRID_LOGIT_TARGET_EPS="${BP_GRID_LOGIT_TARGET_EPS:-1e-4}"
export BP_GRID_LOGIT_HUBER_DELTA="${BP_GRID_LOGIT_HUBER_DELTA:-1.0}"
export PV_TRAINING_FLOW="${PV_TRAINING_FLOW:-staged}"
export PV_EVAL_EPOCHS="${PV_EVAL_EPOCHS:-100}"
export BP_DISTILL_EPOCHS="${BP_DISTILL_EPOCHS:-20}"
export BP_DISTILL_PATIENCE="${BP_DISTILL_PATIENCE:-3}"
export BP_DISTILL_MIN_DELTA="${BP_DISTILL_MIN_DELTA:-1e-4}"
export PV_ROLLBACK_ON_SOFT_SPIKES="${PV_ROLLBACK_ON_SOFT_SPIKES:-0}"
export BP_DISTILL_TRAINABLE_SCOPE="${BP_DISTILL_TRAINABLE_SCOPE:-heads_only}"
export PV_MIXTURE_ENABLED="${PV_MIXTURE_ENABLED:-1}"
export PV_MIXTURE_RATIO="${PV_MIXTURE_RATIO:-0.20}"
export PV_MIXTURE_START_EPISODE="${PV_MIXTURE_START_EPISODE:-1}"
export PV_MIXTURE_BUDGET_MODE="${PV_MIXTURE_BUDGET_MODE:-fixed_total}"
export PV_MIXTURE_SAMPLING_MODE="${PV_MIXTURE_SAMPLING_MODE:-uniform}"
export PV_MIXTURE_COVERAGE_GROUP_SIZE="${PV_MIXTURE_COVERAGE_GROUP_SIZE:-2}"
export PV_MIXTURE_SEED="${PV_MIXTURE_SEED:-24680}"
export PV_MIXTURE_STRATIFIED_VALIDATION="${PV_MIXTURE_STRATIFIED_VALIDATION:-1}"
export PV_MIXTURE_PRESERVE_RNG="${PV_MIXTURE_PRESERVE_RNG:-1}"
export PV_ETA_RESAMPLE_ENABLED="${PV_ETA_RESAMPLE_ENABLED:-0}"
export FIRM_TARGET_UPDATE="${FIRM_TARGET_UPDATE:-stage_hard}"
export MODEB_RESIMULATE_AFTER_PV="${MODEB_RESIMULATE_AFTER_PV:-1}"

# The only intended difference from the matched BP-logit/mixture run:
# train P0/PI equity values in exp(x+z)-scaled latent space, while reporting
# physical values through the model's value-scale parameterization.
export PV_VALUE_SCALE_MODE="${PV_VALUE_SCALE_MODE:-exp_xz}"
export PV_VALUE_SCALE_LOG_MAX="${PV_VALUE_SCALE_LOG_MAX:-20.0}"
export PV_BELLMAN_NORMALIZE_BY_VALUE_SCALE="${PV_BELLMAN_NORMALIZE_BY_VALUE_SCALE:-1}"

echo "Dispatching scaled-value pilot through run_normalized_sdf_aio_bp_logit.slurm"
echo "RUN_ROOT=$RUN_ROOT"
echo "PV_VALUE_SCALE_MODE=$PV_VALUE_SCALE_MODE"
echo "PV_BELLMAN_NORMALIZE_BY_VALUE_SCALE=$PV_BELLMAN_NORMALIZE_BY_VALUE_SCALE"

exec bash "$REPO_DIR/slurm/run_normalized_sdf_aio_bp_logit.slurm"
