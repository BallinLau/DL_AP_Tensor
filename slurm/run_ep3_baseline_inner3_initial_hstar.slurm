#!/bin/bash
#SBATCH -J ep3-inner3-hstar
#SBATCH -N 1
#SBATCH -p a01
#SBATCH -o /home/fit/zhuyingz/WORK/LiuHao/logs/ep3_inner3_hstar_output.%j
#SBATCH -e /home/fit/zhuyingz/WORK/LiuHao/logs/ep3_inner3_hstar_error.%j
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --time=1-00:00:00

# Episode-4 continuation of the 2026-10-14 ep3 baseline.
#
# BASE_SOURCE_COMMIT=004a2ad
# INITIAL_SOURCE_EPISODE=3
# TRAINING_START_EPISODE=4
# FIRM_INNER_CYCLES=3
# INITIAL_HSTAR_ONLY_T0=true
# BASELINE_MODEB_FRESH100=true
# STATE_BANK_ENABLED=false
# NEW_JOINT_COVERAGE=false
# NEW_H10_H100=false
# NEW_DYNAMIC_EMPIRICAL=false
# NEW_REFERENCE_MACRO=false
# SIMULATION_BP_ACTION_SOURCE=grid
# BP_HEAD_TRAINING_ENABLED=false
# BP_HEAD_OPTIMIZER_STEPS=0
# SIMULATION_BP_GRID_N_CHILD_SHOCKS=2
# SIMULATION_BP_GRID_SHOCK_SEED=314159
#
# Everything except the two added features is inherited from the committed
# ep3 Fresh100 chain script, so no ep3 parameter can silently drift here.

set -euo pipefail

WORK_ROOT="${WORK_ROOT:-/home/fit/zhuyingz/WORK/LiuHao}"
REPO_DIR="${REPO_DIR:-$WORK_ROOT/worktrees/ep3_baseline_004a2ad}"
STAMP=$(date +%Y%m%d_%H%M%S)

SOURCE_RUN_ROOT="${SOURCE_RUN_ROOT:-$WORK_ROOT/cachedir/normalized_sdf_aio_bp_logit_scaled_value_eta25_bp500_investment_compare_fresh100_20261014_105652}"
SOURCE_EP3_CHECKPOINT="${SOURCE_EP3_CHECKPOINT:-$SOURCE_RUN_ROOT/checkpoints/ep3_combined.pt}"

export REPO_DIR
export REQUIRED_COMMIT="${REQUIRED_COMMIT:-$(git -C "$REPO_DIR" rev-parse HEAD)}"
export RUN_ROOT="${RUN_ROOT:-$WORK_ROOT/cachedir/ep3_fresh100_inner3_initial_hstar_${STAMP}}"

export N_EPISODES="${N_EPISODES:-1}"
export INITIAL_CHECKPOINT="${INITIAL_CHECKPOINT:-$SOURCE_EP3_CHECKPOINT}"
export INITIAL_CHECKPOINT_EPISODE="${INITIAL_CHECKPOINT_EPISODE:-3}"
export INITIAL_CHECKPOINT_MODE="${INITIAL_CHECKPOINT_MODE:-continuation}"
export START_EPISODE="${START_EPISODE:-4}"
export RESUME_CLASSIFICATION="${RESUME_CLASSIFICATION:-WEIGHTS_ONLY_CONTINUATION}"

# Feature A: three frozen-macro Firm inner value cycles per Episode.
export FIRM_INNER_CYCLES="${FIRM_INNER_CYCLES:-3}"
# Hybrid Firm Solver: each Inner = P Policy Iteration x3 -> EP3 Q Staged x1.
# The P stage solves the b291-style frozen-policy dynamic Bellman residual;
# the Q stage keeps the EP3 Q0/QD/QS/Polish regime-staged training unchanged.
export P_SOLVER="${P_SOLVER:-frozen_policy_dynamic_residual}"
export P_POLICY_ITERATIONS_PER_INNER="${P_POLICY_ITERATIONS_PER_INNER:-3}"
export P_ROOT_ADAM_STEPS="${P_ROOT_ADAM_STEPS:-200}"
export P_ROOT_ADAM_LR="${P_ROOT_ADAM_LR:-1e-4}"
export P_ROOT_ADAM_CLIP="${P_ROOT_ADAM_CLIP:-10.0}"
export P_ROOT_EVAL_EVERY="${P_ROOT_EVAL_EVERY:-10}"
export P_ROOT_LBFGS_MAX_ITER="${P_ROOT_LBFGS_MAX_ITER:-100}"
export P_ROOT_LBFGS_CHUNK_ITERATIONS="${P_ROOT_LBFGS_CHUNK_ITERATIONS:-20}"
export P_ROOT_LBFGS_HISTORY_SIZE="${P_ROOT_LBFGS_HISTORY_SIZE:-50}"
export Q_SOLVER="${Q_SOLVER:-ep3_regime_staged}"
export Q_ZERO_BOUNDARY_EPOCHS="${Q_ZERO_BOUNDARY_EPOCHS:-5}"
export Q_DEFAULT_PRETRAIN_EPOCHS="${Q_DEFAULT_PRETRAIN_EPOCHS:-10}"
export Q_SURVIVAL_AIO_EPOCHS="${Q_SURVIVAL_AIO_EPOCHS:-20}"
export Q_MIXED_POLISH_EPOCHS="${Q_MIXED_POLISH_EPOCHS:-5}"
# Feature B: strict t=0 macro clearing; t>=1 keeps the FC1 forecast.
export INITIAL_HSTAR_ENABLED="${INITIAL_HSTAR_ENABLED:-1}"
export INITIAL_HSTAR_RESIDUAL_TOLERANCE="${INITIAL_HSTAR_RESIDUAL_TOLERANCE:-1e-5}"
export INITIAL_HSTAR_PARITY_TOLERANCE="${INITIAL_HSTAR_PARITY_TOLERANCE:-1e-5}"
export INITIAL_HSTAR_MAX_ITERATIONS="${INITIAL_HSTAR_MAX_ITERATIONS:-40}"
# A800 80GB 显存充裕：放大 BP grid teacher 分块上限（纯执行细节，数学不变）
export BP_GRID_MAX_EXPANDED_STATES="${BP_GRID_MAX_EXPANDED_STATES:-262144}"
# STRICT_GLOBAL solver settings mirror the verified b291c64 controller
# defaults; economic evaluation stays on the ep3 production node operator.
export INITIAL_HSTAR_COARSE_POINTS="${INITIAL_HSTAR_COARSE_POINTS:-10}"
export INITIAL_HSTAR_REFINEMENT_POINTS="${INITIAL_HSTAR_REFINEMENT_POINTS:-20}"
export INITIAL_HSTAR_MAX_REFINEMENT_ROUNDS="${INITIAL_HSTAR_MAX_REFINEMENT_ROUNDS:-4}"
export INITIAL_HSTAR_SUPPORT_LOWER="${INITIAL_HSTAR_SUPPORT_LOWER:--8.0}"
export INITIAL_HSTAR_SUPPORT_UPPER="${INITIAL_HSTAR_SUPPORT_UPPER:-2.0}"
export INITIAL_HSTAR_WIDTH_TOLERANCE="${INITIAL_HSTAR_WIDTH_TOLERANCE:-1e-5}"
export INITIAL_HSTAR_AUDIT_OUTPUT_DIR="${INITIAL_HSTAR_AUDIT_OUTPUT_DIR:-$RUN_ROOT/hstar_audit}"

# Feature C: simulation leverage comes from the Grid BP policy; the retained
# BP head is never trained and only produces read-only diagnostics.
export SIMULATION_BP_ACTION_SOURCE="${SIMULATION_BP_ACTION_SOURCE:-grid}"
export PV_BP_HEAD_TRAINING_ENABLED="${PV_BP_HEAD_TRAINING_ENABLED:-0}"
export SIMULATION_BP_GRID_N_CHILD_SHOCKS="${SIMULATION_BP_GRID_N_CHILD_SHOCKS:-2}"
export SIMULATION_BP_GRID_SHOCK_SEED="${SIMULATION_BP_GRID_SHOCK_SEED:-314159}"

if [[ ! -f "$INITIAL_CHECKPOINT" ]]; then
  echo "ERROR: ep3 source checkpoint not found: $INITIAL_CHECKPOINT"
  exit 1
fi

echo "=== ep3 baseline + inner3 + initial h-star + grid BP ==="
echo "BASE_SOURCE_COMMIT=004a2ad"
echo "REPO_DIR=$REPO_DIR"
echo "REQUIRED_COMMIT=$REQUIRED_COMMIT"
echo "INITIAL_CHECKPOINT=$INITIAL_CHECKPOINT"
echo "INITIAL_CHECKPOINT_EPISODE=$INITIAL_CHECKPOINT_EPISODE"
echo "INITIAL_CHECKPOINT_MODE=$INITIAL_CHECKPOINT_MODE"
echo "START_EPISODE=$START_EPISODE"
echo "N_EPISODES=$N_EPISODES"
echo "FIRM_INNER_CYCLES=$FIRM_INNER_CYCLES"
echo "P_SOLVER=$P_SOLVER"
echo "P_POLICY_ITERATIONS_PER_INNER=$P_POLICY_ITERATIONS_PER_INNER"
echo "P_ROOT_ADAM_STEPS=$P_ROOT_ADAM_STEPS P_ROOT_ADAM_LR=$P_ROOT_ADAM_LR"
echo "P_ROOT_LBFGS_MAX_ITER=$P_ROOT_LBFGS_MAX_ITER P_ROOT_LBFGS_CHUNK_ITERATIONS=$P_ROOT_LBFGS_CHUNK_ITERATIONS"
echo "Q_SOLVER=$Q_SOLVER"
echo "INITIAL_HSTAR_ENABLED=$INITIAL_HSTAR_ENABLED"
echo "RESUME_CLASSIFICATION=$RESUME_CLASSIFICATION"
echo "SIMULATION_BP_ACTION_SOURCE=$SIMULATION_BP_ACTION_SOURCE"
echo "PV_BP_HEAD_TRAINING_ENABLED=$PV_BP_HEAD_TRAINING_ENABLED"
echo "SIMULATION_BP_GRID_N_CHILD_SHOCKS=$SIMULATION_BP_GRID_N_CHILD_SHOCKS"
echo "SIMULATION_BP_GRID_SHOCK_SEED=$SIMULATION_BP_GRID_SHOCK_SEED"
echo "GRID_BP_CONFIGURED=true"
echo "GRID_BP_ACTUALLY_USED_IN_ECONOMIC_TRANSITIONS=checked_runtime_via_evidence"

exec bash "$REPO_DIR/slurm/run_normalized_sdf_aio_bp_logit_scaled_value_eta25_bp500_investment_compare_fresh100.slurm"
