#!/bin/bash
#SBATCH -J dl-normalized-sdf-aio-bp-logit
#SBATCH -N 1
#SBATCH -p a01
#SBATCH -o /home/fit/zhuyingz/WORK/LiuHao/logs/dl_normalized_sdf_aio_bp_logit_output.%j
#SBATCH -e /home/fit/zhuyingz/WORK/LiuHao/logs/dl_normalized_sdf_aio_bp_logit_error.%j
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --time=1-00:00:00

set -euo pipefail

source /apps/soft/anaconda3/bin/activate
conda activate DL_HL

WORK_ROOT="${WORK_ROOT:-/home/fit/zhuyingz/WORK/LiuHao}"
REPO_DIR="${REPO_DIR:-$WORK_ROOT/DL_AP_Tensor}"
LOG_DIR="${LOG_DIR:-$WORK_ROOT/logs}"
STAMP=$(date +%Y%m%d_%H%M%S)
REQUIRED_COMMIT="${REQUIRED_COMMIT:?REQUIRED_COMMIT must be set}"

RUN_ROOT="${RUN_ROOT:-$WORK_ROOT/cachedir/normalized_sdf_aio_bp_logit_${STAMP}}"
SEED="${SEED:-12345}"
N_EPISODES="${N_EPISODES:-10}"
EPOCHS="${EPOCHS:-20}"
N_PATHS="${N_PATHS:-400}"
POST0_N_PATHS="${POST0_N_PATHS:-400}"
# Legacy fallback for entrypoints that still consume the global batch size.
BATCH_SIZE="${BATCH_SIZE:-4096}"
# Firm-level Policy/Value batch.
PV_BATCH_SIZE="${PV_BATCH_SIZE:-20480}"
# Macro parent-group FC1/SDF batch.
SDF_FC1_BATCH_SIZE="${SDF_FC1_BATCH_SIZE:-4096}"
SIMULATE_GROUP_SIZE="${SIMULATE_GROUP_SIZE:-200}"
SIMULATE_HORIZON="${SIMULATE_HORIZON:-100}"
POST0_MODE="${POST0_MODE:-modeb}"
ALTERNATE_START="${ALTERNATE_START:-modea}"
ENABLE_FC2="${ENABLE_FC2:-0}"
QUICK_TEST="${QUICK_TEST:-0}"
SDF_WEALTH_LOSS_MODE="${SDF_WEALTH_LOSS_MODE:-signed_aio}"
SDF_FRESH_PAIR_ENABLED="${SDF_FRESH_PAIR_ENABLED:-1}"
SDF_CHILD_BANK_SIZE="${SDF_CHILD_BANK_SIZE:-16}"
SDF_CHILD_BANK_REFRESH_EPOCHS="${SDF_CHILD_BANK_REFRESH_EPOCHS:-1}"
SDF_CHILD_BANK_SEED="${SDF_CHILD_BANK_SEED:-12345}"
EPISODE0_SDF_EPOCHS_PER_ROUND="${EPISODE0_SDF_EPOCHS_PER_ROUND:-20}"
EPISODE0_SDF_MAX_ROUNDS="${EPISODE0_SDF_MAX_ROUNDS:-20}"
EPISODE0_SDF_LOG_MEAN_ERROR_MAX="${EPISODE0_SDF_LOG_MEAN_ERROR_MAX:-0.25}"
EPISODE0_SDF_CLIP_LOW_RATIO_MAX="${EPISODE0_SDF_CLIP_LOW_RATIO_MAX:-0.20}"
EPISODE0_SDF_FINITE_RATIO_MIN="${EPISODE0_SDF_FINITE_RATIO_MIN:-1.0}"
SDF_TRUE_ONLY_EPOCHS="${SDF_TRUE_ONLY_EPOCHS:-100}"
SDF_TRUE_START_EPISODE="${SDF_TRUE_START_EPISODE:-2}"
SDF_RECURSIVE_ONLY_EPOCHS="${SDF_RECURSIVE_ONLY_EPOCHS:-0}"
SDF_STAGE2_LR="${SDF_STAGE2_LR:-2e-4}"
SDF_TRUE_ONLY_LR="${SDF_TRUE_ONLY_LR:-4e-5}"
SDF_TRUE_TARGET_BATCHES="${SDF_TRUE_TARGET_BATCHES:-20}"
SDF_MIN_PARENT_GROUPS_PER_BATCH="${SDF_MIN_PARENT_GROUPS_PER_BATCH:-256}"
SDF_TRUE_MOMENT_WEIGHT="${SDF_TRUE_MOMENT_WEIGHT:-5e-4}"
SDF_TRUE_ANCHOR_WEIGHT="${SDF_TRUE_ANCHOR_WEIGHT:-0.05}"
SDF_AL_RHO="${SDF_AL_RHO:-2.0}"
SDF_AL_PRIMAL_EPOCHS_PER_DUAL_UPDATE="${SDF_AL_PRIMAL_EPOCHS_PER_DUAL_UPDATE:-5}"
SDF_CONTINUE_CONSTRAINT_TOL="${SDF_CONTINUE_CONSTRAINT_TOL:-0.02}"
SDF_AIO_PROGRESS_RATIO_MAX="${SDF_AIO_PROGRESS_RATIO_MAX:-0.80}"
SDF_AIO_GOOD_ABS_TOL="${SDF_AIO_GOOD_ABS_TOL:-1e-3}"
SDF_FINAL_CONSTRAINT_TOL="${SDF_FINAL_CONSTRAINT_TOL:-1e-3}"
SDF_FINAL_MAX_SIGNED_T_ABS="${SDF_FINAL_MAX_SIGNED_T_ABS:-2.0}"
SDF_FINAL_AIO_MEAN_TOL="${SDF_FINAL_AIO_MEAN_TOL:-1e-3}"
SDF_RESET_OPTIMIZER_ON_TRUE_START="${SDF_RESET_OPTIMIZER_ON_TRUE_START:-0}"
SDF_RESTORE_BEST_CHECKPOINT="${SDF_RESTORE_BEST_CHECKPOINT:-1}"
SDF_COLLAPSE_LOG_MEAN_ERROR="${SDF_COLLAPSE_LOG_MEAN_ERROR:-0.5}"
SDF_COLLAPSE_MEAN_RATIO="${SDF_COLLAPSE_MEAN_RATIO:-0.10}"
FC1_JACOBIAN_PENALTY_INTERVAL="${FC1_JACOBIAN_PENALTY_INTERVAL:-10}"
BP_GRID_POLICY_LOSS_SPACE="${BP_GRID_POLICY_LOSS_SPACE:-logit}"
BP_GRID_LOGIT_TARGET_EPS="${BP_GRID_LOGIT_TARGET_EPS:-1e-4}"
BP_GRID_LOGIT_HUBER_DELTA="${BP_GRID_LOGIT_HUBER_DELTA:-1.0}"
PV_VALUE_SCALE_MODE="${PV_VALUE_SCALE_MODE:-none}"
PV_VALUE_SCALE_LOG_MAX="${PV_VALUE_SCALE_LOG_MAX:-20.0}"
PV_BELLMAN_NORMALIZE_BY_VALUE_SCALE="${PV_BELLMAN_NORMALIZE_BY_VALUE_SCALE:-0}"
PV_TRAINING_FLOW="${PV_TRAINING_FLOW:-staged}"
PV_EVAL_EPOCHS="${PV_EVAL_EPOCHS:-$EPOCHS}"
Q_PARAMETERIZATION="${Q_PARAMETERIZATION:-direct}"
Q_ZERO_BOUNDARY_EPOCHS="${Q_ZERO_BOUNDARY_EPOCHS:-5}"
Q_DEFAULT_PRETRAIN_EPOCHS="${Q_DEFAULT_PRETRAIN_EPOCHS:-10}"
Q_SURVIVAL_AIO_EPOCHS="${Q_SURVIVAL_AIO_EPOCHS:-20}"
Q_MIXED_POLISH_EPOCHS="${Q_MIXED_POLISH_EPOCHS:-5}"
Q_ZERO_SAMPLE_SHARE="${Q_ZERO_SAMPLE_SHARE:-0.20}"
Q_DEFAULT_SAMPLE_SHARE="${Q_DEFAULT_SAMPLE_SHARE:-0.30}"
Q_SURVIVAL_SAMPLE_SHARE="${Q_SURVIVAL_SAMPLE_SHARE:-0.50}"
Q_DEFAULT_PHAT_EPS="${Q_DEFAULT_PHAT_EPS:-1e-2}"
Q_ZERO_B_EPS="${Q_ZERO_B_EPS:-0.0}"
Q_DEFAULT_CANDIDATE_MULTIPLIER="${Q_DEFAULT_CANDIDATE_MULTIPLIER:-4}"
Q_DEFAULT_B_BINS="${Q_DEFAULT_B_BINS:-10}"
Q_SURVIVAL_ONDIST_SHARE="${Q_SURVIVAL_ONDIST_SHARE:-0.80}"
Q_CLAIM_COVERAGE_ENABLED="${Q_CLAIM_COVERAGE_ENABLED:-true}"
Q_CLAIM_COVERAGE_B_BINS="${Q_CLAIM_COVERAGE_B_BINS:-10}"
Q_CLAIM_COVERAGE_START_EPISODE="${Q_CLAIM_COVERAGE_START_EPISODE:-0}"
Q_CLAIM_COVERAGE_LOW_B_ENABLED="${Q_CLAIM_COVERAGE_LOW_B_ENABLED:-0}"
Q_CLAIM_COVERAGE_LOW_B_ANCHORS="${Q_CLAIM_COVERAGE_LOW_B_ANCHORS:-0.005,0.01,0.025}"
Q_ZERO_LOSS_WEIGHT="${Q_ZERO_LOSS_WEIGHT:-1.0}"
Q_DEFAULT_LOSS_WEIGHT="${Q_DEFAULT_LOSS_WEIGHT:-1.0}"
Q_SURVIVAL_LOSS_WEIGHT="${Q_SURVIVAL_LOSS_WEIGHT:-1.0}"
Q_NONNEGATIVE_WEIGHT="${Q_NONNEGATIVE_WEIGHT:-1.0}"
BP_DISTILL_EPOCHS="${BP_DISTILL_EPOCHS:-20}"
BP_DISTILL_PATIENCE="${BP_DISTILL_PATIENCE:-3}"
BP_DISTILL_MIN_DELTA="${BP_DISTILL_MIN_DELTA:-1e-4}"
BP_DISTILL_MAX_OPTIMIZER_STEPS="${BP_DISTILL_MAX_OPTIMIZER_STEPS:-0}"
BP_CURRENT_ETA_RESAMPLE_ENABLED="${BP_CURRENT_ETA_RESAMPLE_ENABLED:-0}"
BP_CURRENT_ETA1_TRAIN_SHARE="${BP_CURRENT_ETA1_TRAIN_SHARE:-0.25}"
BP_CURRENT_ETA_RESAMPLE_SEED="${BP_CURRENT_ETA_RESAMPLE_SEED:-13579}"
PV_CURRENT_ETA_BALANCE_ENABLED="${PV_CURRENT_ETA_BALANCE_ENABLED:-0}"
PV_CURRENT_ETA1_TRAIN_SHARE="${PV_CURRENT_ETA1_TRAIN_SHARE:-0.50}"
PV_CURRENT_ETA_BALANCE_VALIDATION="${PV_CURRENT_ETA_BALANCE_VALIDATION:-1}"
PV_CURRENT_ETA_BALANCE_SEED="${PV_CURRENT_ETA_BALANCE_SEED:-97531}"
PV_ROLLBACK_ON_SOFT_SPIKES="${PV_ROLLBACK_ON_SOFT_SPIKES:-0}"
BP_DISTILL_TRAINABLE_SCOPE="${BP_DISTILL_TRAINABLE_SCOPE:-heads_only}"
PV_MIXTURE_ENABLED="${PV_MIXTURE_ENABLED:-0}"
PV_MIXTURE_RATIO="${PV_MIXTURE_RATIO:-0.20}"
PV_MIXTURE_START_EPISODE="${PV_MIXTURE_START_EPISODE:-1}"
PV_MIXTURE_BUDGET_MODE="${PV_MIXTURE_BUDGET_MODE:-fixed_total}"
PV_MIXTURE_SAMPLING_MODE="${PV_MIXTURE_SAMPLING_MODE:-uniform}"
PV_MIXTURE_COVERAGE_GROUP_SIZE="${PV_MIXTURE_COVERAGE_GROUP_SIZE:-2}"
PV_MIXTURE_SEED="${PV_MIXTURE_SEED:-24680}"
PV_MIXTURE_STRATIFIED_VALIDATION="${PV_MIXTURE_STRATIFIED_VALIDATION:-1}"
PV_MIXTURE_PRESERVE_RNG="${PV_MIXTURE_PRESERVE_RNG:-1}"
PV_ETA_RESAMPLE_ENABLED="${PV_ETA_RESAMPLE_ENABLED:-0}"
PV_EXACT_ETA_INTEGRATION_ENABLED="${PV_EXACT_ETA_INTEGRATION_ENABLED:-1}"
FIRM_TARGET_UPDATE="${FIRM_TARGET_UPDATE:-stage_hard}"
# Full normalized residual run: Treatment B by default.
MODEB_RESIMULATE_AFTER_PV="${MODEB_RESIMULATE_AFTER_PV:-1}"
# Direct-Q baseline：三项人为 Q 形状先验（Q 单调增于 z / low-b 增于 b / high-b 减于 b）
# 默认全部关闭。需要复现旧 baseline 时显式覆盖为 1。
Q_SHAPE_WEIGHT_Z="${Q_SHAPE_WEIGHT_Z:-0}"
Q_SHAPE_WEIGHT_B_LOW="${Q_SHAPE_WEIGHT_B_LOW:-0}"
Q_SHAPE_WEIGHT_B_HIGH="${Q_SHAPE_WEIGHT_B_HIGH:-0}"
# Episode-0 direct-Q cold-start bootstrap（只做 shell -> CLI 透传，不重复 Python 默认值）。
Q_BOOTSTRAP_EPOCHS="${Q_BOOTSTRAP_EPOCHS:-5}"
Q_BOOTSTRAP_MODE="${Q_BOOTSTRAP_MODE:-constant_unit}"
Q_BOOTSTRAP_UNIT_VALUE="${Q_BOOTSTRAP_UNIT_VALUE:-1.0}"
Q_BOOTSTRAP_NONNEGATIVE_WEIGHT="${Q_BOOTSTRAP_NONNEGATIVE_WEIGHT:-1.0}"
Q_STRUCTURAL_ZERO_TOL="${Q_STRUCTURAL_ZERO_TOL:-1e-8}"
Q_STRUCTURAL_RECOVERY_TOL="${Q_STRUCTURAL_RECOVERY_TOL:-1e-6}"
Q_BOUNDARY_MATCH_WEIGHT="${Q_BOUNDARY_MATCH_WEIGHT:-0.0}"
Q_BOUNDARY_MATCH_PHAT_EPS="${Q_BOUNDARY_MATCH_PHAT_EPS:-1e-2}"
Q_BOUNDARY_MATCH_MIN_SAMPLES="${Q_BOUNDARY_MATCH_MIN_SAMPLES:-0}"
# Q0/QD/QS required-phase gate。
Q_REQUIRE_ZERO_PHASE="${Q_REQUIRE_ZERO_PHASE:-true}"
Q_REQUIRE_DEFAULT_PHASE="${Q_REQUIRE_DEFAULT_PHASE:-true}"
Q_REQUIRE_SURVIVAL_PHASE="${Q_REQUIRE_SURVIVAL_PHASE:-true}"

mkdir -p "$LOG_DIR" "$RUN_ROOT" "$WORK_ROOT/cachedir" "$WORK_ROOT/.mplcache"
cd "$REPO_DIR"

export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-8}
export MKL_NUM_THREADS=${SLURM_CPUS_PER_TASK:-8}
export PYTHONUNBUFFERED=1
export MPLCONFIGDIR="$WORK_ROOT/.mplcache"
export SDF_TRUE_ONLY_LR
export SDF_TRUE_TARGET_BATCHES
export SDF_MIN_PARENT_GROUPS_PER_BATCH

echo "Job started on $(date)"
echo "Host: $(hostname)"
echo "Repo: $REPO_DIR"
echo "Branch: $(git branch --show-current)"
ACTUAL_COMMIT="$(git rev-parse HEAD)"
echo "Commit: $(git rev-parse --short HEAD)"
echo "Required commit: $REQUIRED_COMMIT"
if [[ "$ACTUAL_COMMIT" != "$REQUIRED_COMMIT" ]]; then
  echo "Expected: $REQUIRED_COMMIT"
  echo "Actual:   $ACTUAL_COMMIT"
  exit 1
fi
if [[ -n "$(git status --porcelain)" ]]; then
  echo "ERROR: working tree is not clean"
  git status --short
  exit 1
fi
echo "Run root: $RUN_ROOT"
echo "Python: $(which python3)"
echo "Torch/CUDA check:"
python3 - <<'PY'
import torch
print("  torch:", torch.__version__)
print("  cuda_available:", torch.cuda.is_available())
print("  cuda_device_count:", torch.cuda.device_count())
if torch.cuda.is_available():
    print("  cuda_device_0:", torch.cuda.get_device_name(0))
else:
    raise SystemExit("CUDA is not available on this Slurm allocation.")
PY

if command -v nvidia-smi >/dev/null 2>&1; then
  nvidia-smi
fi

EXTRA_ARGS=()
if [[ "$ENABLE_FC2" == "1" ]]; then
  EXTRA_ARGS+=(--enable-fc2)
else
  EXTRA_ARGS+=(--no-enable-fc2)
fi
if [[ "$QUICK_TEST" == "1" ]]; then
  EXTRA_ARGS+=(--quick-test)
fi
if [[ "$MODEB_RESIMULATE_AFTER_PV" == "1" ]]; then
  EXTRA_ARGS+=(--modeb-resimulate-after-pv)
else
  EXTRA_ARGS+=(--no-modeb-resimulate-after-pv)
fi
if [[ "$SDF_FRESH_PAIR_ENABLED" == "1" ]]; then
  EXTRA_ARGS+=(--sdf-fresh-pair-enabled)
else
  EXTRA_ARGS+=(--no-sdf-fresh-pair-enabled)
fi
if [[ "$SDF_RESET_OPTIMIZER_ON_TRUE_START" == "1" ]]; then
  EXTRA_ARGS+=(--sdf-reset-optimizer-on-true-start)
else
  EXTRA_ARGS+=(--no-sdf-reset-optimizer-on-true-start)
fi
if [[ "$SDF_RESTORE_BEST_CHECKPOINT" == "1" ]]; then
  EXTRA_ARGS+=(--sdf-restore-best-checkpoint)
else
  EXTRA_ARGS+=(--no-sdf-restore-best-checkpoint)
fi
if [[ "$PV_ROLLBACK_ON_SOFT_SPIKES" == "1" ]]; then
  EXTRA_ARGS+=(--pv-rollback-on-soft-spikes)
else
  EXTRA_ARGS+=(--no-pv-rollback-on-soft-spikes)
fi
if [[ "$PV_BELLMAN_NORMALIZE_BY_VALUE_SCALE" == "1" ]]; then
  EXTRA_ARGS+=(--pv-bellman-normalize-by-value-scale)
else
  EXTRA_ARGS+=(--no-pv-bellman-normalize-by-value-scale)
fi
if [[ "$PV_MIXTURE_ENABLED" == "1" ]]; then
  EXTRA_ARGS+=(--pv-mixture-enabled)
else
  EXTRA_ARGS+=(--no-pv-mixture-enabled)
fi
if [[ "$PV_MIXTURE_STRATIFIED_VALIDATION" == "1" ]]; then
  EXTRA_ARGS+=(--pv-mixture-stratified-validation)
else
  EXTRA_ARGS+=(--no-pv-mixture-stratified-validation)
fi
if [[ "$PV_MIXTURE_PRESERVE_RNG" == "1" ]]; then
  EXTRA_ARGS+=(--pv-mixture-preserve-rng)
else
  EXTRA_ARGS+=(--no-pv-mixture-preserve-rng)
fi
if [[ "$PV_ETA_RESAMPLE_ENABLED" == "1" ]]; then
  EXTRA_ARGS+=(--pv-eta-resample-enabled)
else
  EXTRA_ARGS+=(--no-pv-eta-resample-enabled)
fi
if [[ "$PV_EXACT_ETA_INTEGRATION_ENABLED" == "1" ]]; then
  EXTRA_ARGS+=(--pv-exact-eta-integration-enabled)
else
  EXTRA_ARGS+=(--no-pv-exact-eta-integration-enabled)
fi
if [[ "$BP_CURRENT_ETA_RESAMPLE_ENABLED" == "1" ]]; then
  EXTRA_ARGS+=(--bp-current-eta-resample-enabled)
else
  EXTRA_ARGS+=(--no-bp-current-eta-resample-enabled)
fi
if [[ "$PV_CURRENT_ETA_BALANCE_ENABLED" == "1" ]]; then
  EXTRA_ARGS+=(--pv-current-eta-balance-enabled)
else
  EXTRA_ARGS+=(--no-pv-current-eta-balance-enabled)
fi
if [[ "$PV_CURRENT_ETA_BALANCE_VALIDATION" == "1" ]]; then
  EXTRA_ARGS+=(--pv-current-eta-balance-validation)
else
  EXTRA_ARGS+=(--no-pv-current-eta-balance-validation)
fi
if [[ "$Q_CLAIM_COVERAGE_LOW_B_ENABLED" == "1" ]]; then
  EXTRA_ARGS+=(--q-claim-coverage-low-b-enabled)
else
  EXTRA_ARGS+=(--no-q-claim-coverage-low-b-enabled)
fi

echo "Run parameters:"
echo "  SEED=$SEED"
echo "  N_EPISODES=$N_EPISODES"
echo "  EPOCHS=$EPOCHS"
echo "  N_PATHS=$N_PATHS"
echo "  POST0_N_PATHS=$POST0_N_PATHS"
echo "  BATCH_SIZE=$BATCH_SIZE"
echo "  PV_BATCH_SIZE=$PV_BATCH_SIZE"
echo "  SDF_FC1_BATCH_SIZE=$SDF_FC1_BATCH_SIZE"
echo "  SIMULATE_GROUP_SIZE=$SIMULATE_GROUP_SIZE"
echo "  SIMULATE_HORIZON=$SIMULATE_HORIZON"
echo "  POST0_MODE=$POST0_MODE"
echo "  ALTERNATE_START=$ALTERNATE_START"
echo "  ENABLE_FC2=$ENABLE_FC2"
echo "  QUICK_TEST=$QUICK_TEST"
echo "  SDF_WEALTH_LOSS_MODE=$SDF_WEALTH_LOSS_MODE"
echo "  SDF_FRESH_PAIR_ENABLED=$SDF_FRESH_PAIR_ENABLED"
echo "  SDF_CHILD_BANK_SIZE=$SDF_CHILD_BANK_SIZE"
echo "  SDF_CHILD_BANK_REFRESH_EPOCHS=$SDF_CHILD_BANK_REFRESH_EPOCHS"
echo "  SDF_CHILD_BANK_SEED=$SDF_CHILD_BANK_SEED"
echo "  EPISODE0_SDF_EPOCHS_PER_ROUND=$EPISODE0_SDF_EPOCHS_PER_ROUND"
echo "  EPISODE0_SDF_MAX_ROUNDS=$EPISODE0_SDF_MAX_ROUNDS"
echo "  EPISODE0_SDF_LOG_MEAN_ERROR_MAX=$EPISODE0_SDF_LOG_MEAN_ERROR_MAX"
echo "  EPISODE0_SDF_CLIP_LOW_RATIO_MAX=$EPISODE0_SDF_CLIP_LOW_RATIO_MAX"
echo "  EPISODE0_SDF_FINITE_RATIO_MIN=$EPISODE0_SDF_FINITE_RATIO_MIN"
echo "  SDF_TRUE_ONLY_EPOCHS=$SDF_TRUE_ONLY_EPOCHS"
echo "  SDF_TRUE_START_EPISODE=$SDF_TRUE_START_EPISODE"
echo "  SDF_RECURSIVE_ONLY_EPOCHS=$SDF_RECURSIVE_ONLY_EPOCHS"
echo "  SDF_STAGE2_LR=$SDF_STAGE2_LR"
echo "  SDF_TRUE_ONLY_LR=$SDF_TRUE_ONLY_LR"
echo "  SDF_TRUE_TARGET_BATCHES=$SDF_TRUE_TARGET_BATCHES"
echo "  SDF_MIN_PARENT_GROUPS_PER_BATCH=$SDF_MIN_PARENT_GROUPS_PER_BATCH"
echo "  SDF_TRUE_MOMENT_WEIGHT=$SDF_TRUE_MOMENT_WEIGHT"
echo "  SDF_TRUE_ANCHOR_WEIGHT=$SDF_TRUE_ANCHOR_WEIGHT"
echo "  SDF_AL_RHO=$SDF_AL_RHO"
echo "  SDF_AL_PRIMAL_EPOCHS_PER_DUAL_UPDATE=$SDF_AL_PRIMAL_EPOCHS_PER_DUAL_UPDATE"
echo "  SDF_CONTINUE_CONSTRAINT_TOL=$SDF_CONTINUE_CONSTRAINT_TOL"
echo "  SDF_AIO_PROGRESS_RATIO_MAX=$SDF_AIO_PROGRESS_RATIO_MAX"
echo "  SDF_AIO_GOOD_ABS_TOL=$SDF_AIO_GOOD_ABS_TOL"
echo "  SDF_FINAL_CONSTRAINT_TOL=$SDF_FINAL_CONSTRAINT_TOL"
echo "  SDF_FINAL_MAX_SIGNED_T_ABS=$SDF_FINAL_MAX_SIGNED_T_ABS"
echo "  SDF_FINAL_AIO_MEAN_TOL=$SDF_FINAL_AIO_MEAN_TOL"
echo "  SDF_RESET_OPTIMIZER_ON_TRUE_START=$SDF_RESET_OPTIMIZER_ON_TRUE_START"
echo "  SDF_RESTORE_BEST_CHECKPOINT=$SDF_RESTORE_BEST_CHECKPOINT"
echo "  SDF_COLLAPSE_LOG_MEAN_ERROR=$SDF_COLLAPSE_LOG_MEAN_ERROR"
echo "  SDF_COLLAPSE_MEAN_RATIO=$SDF_COLLAPSE_MEAN_RATIO"
echo "  FC1_JACOBIAN_PENALTY_INTERVAL=$FC1_JACOBIAN_PENALTY_INTERVAL"
echo "  BP_GRID_POLICY_LOSS_SPACE=$BP_GRID_POLICY_LOSS_SPACE"
echo "  BP_GRID_LOGIT_TARGET_EPS=$BP_GRID_LOGIT_TARGET_EPS"
echo "  BP_GRID_LOGIT_HUBER_DELTA=$BP_GRID_LOGIT_HUBER_DELTA"
echo "  PV_VALUE_SCALE_MODE=$PV_VALUE_SCALE_MODE"
echo "  PV_VALUE_SCALE_LOG_MAX=$PV_VALUE_SCALE_LOG_MAX"
echo "  PV_BELLMAN_NORMALIZE_BY_VALUE_SCALE=$PV_BELLMAN_NORMALIZE_BY_VALUE_SCALE"
echo "  PV_TRAINING_FLOW=$PV_TRAINING_FLOW"
echo "  PV_EVAL_EPOCHS=$PV_EVAL_EPOCHS"
echo "  Q_PARAMETERIZATION=$Q_PARAMETERIZATION"
echo "  Q_ZERO_BOUNDARY_EPOCHS=$Q_ZERO_BOUNDARY_EPOCHS"
echo "  Q_DEFAULT_PRETRAIN_EPOCHS=$Q_DEFAULT_PRETRAIN_EPOCHS"
echo "  Q_SURVIVAL_AIO_EPOCHS=$Q_SURVIVAL_AIO_EPOCHS"
echo "  Q_MIXED_POLISH_EPOCHS=$Q_MIXED_POLISH_EPOCHS"
echo "  Q_ZERO_SAMPLE_SHARE=$Q_ZERO_SAMPLE_SHARE"
echo "  Q_DEFAULT_SAMPLE_SHARE=$Q_DEFAULT_SAMPLE_SHARE"
echo "  Q_SURVIVAL_SAMPLE_SHARE=$Q_SURVIVAL_SAMPLE_SHARE"
echo "  Q_DEFAULT_PHAT_EPS=$Q_DEFAULT_PHAT_EPS"
echo "  Q_ZERO_B_EPS=$Q_ZERO_B_EPS"
echo "  Q_DEFAULT_CANDIDATE_MULTIPLIER=$Q_DEFAULT_CANDIDATE_MULTIPLIER"
echo "  Q_DEFAULT_B_BINS=$Q_DEFAULT_B_BINS"
echo "  Q_SURVIVAL_ONDIST_SHARE=$Q_SURVIVAL_ONDIST_SHARE"
echo "  Q_CLAIM_COVERAGE_ENABLED=$Q_CLAIM_COVERAGE_ENABLED"
echo "  Q_CLAIM_COVERAGE_B_BINS=$Q_CLAIM_COVERAGE_B_BINS"
echo "  Q_CLAIM_COVERAGE_START_EPISODE=$Q_CLAIM_COVERAGE_START_EPISODE"
echo "  Q_CLAIM_COVERAGE_LOW_B_ENABLED=$Q_CLAIM_COVERAGE_LOW_B_ENABLED"
echo "  Q_CLAIM_COVERAGE_LOW_B_ANCHORS=$Q_CLAIM_COVERAGE_LOW_B_ANCHORS"
echo "  Q_ZERO_LOSS_WEIGHT=$Q_ZERO_LOSS_WEIGHT"
echo "  Q_DEFAULT_LOSS_WEIGHT=$Q_DEFAULT_LOSS_WEIGHT"
echo "  Q_SURVIVAL_LOSS_WEIGHT=$Q_SURVIVAL_LOSS_WEIGHT"
echo "  Q_NONNEGATIVE_WEIGHT=$Q_NONNEGATIVE_WEIGHT"
echo "  BP_DISTILL_EPOCHS=$BP_DISTILL_EPOCHS"
echo "  BP_DISTILL_PATIENCE=$BP_DISTILL_PATIENCE"
echo "  BP_DISTILL_MIN_DELTA=$BP_DISTILL_MIN_DELTA"
echo "  BP_DISTILL_MAX_OPTIMIZER_STEPS=$BP_DISTILL_MAX_OPTIMIZER_STEPS"
echo "  BP_CURRENT_ETA_RESAMPLE_ENABLED=$BP_CURRENT_ETA_RESAMPLE_ENABLED"
echo "  BP_CURRENT_ETA1_TRAIN_SHARE=$BP_CURRENT_ETA1_TRAIN_SHARE"
